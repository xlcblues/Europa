{
  "name": "europa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Europa - a quiet Windows desktop arcade for three small games.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build": "npm run typecheck && vite build",
    "tauri": "tauri",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "globals": "16.5.0",
    "jsdom": "29.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
